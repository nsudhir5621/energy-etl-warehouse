# Copy to .env and fill in. NEVER commit .env.
# .env is already in .gitignore; this file is the committed template.

# -- Required for any live source call -----------------------------------------
# Free key: https://api.eia.gov/signup/
# DEMO_KEY is NOT usable here: it advertises X-Ratelimit-Limit: 10 and locks the
# key out for ~96 minutes once exceeded. See docs/source-data.md section 9.
EIA_API_KEY=

# -- Source selection (defaults shown; all optional) ---------------------------
# EIA_BASE_URL=https://api.eia.gov/v2
# EIA_ROUTE=electricity/electric-power-operational-data
# EIA_FREQUENCY=monthly
# EIA_MEASURE=generation

# -- Pagination ---------------------------------------------------------------
# The API refuses to return more than 5000 rows in JSON. Values above that are
# rejected at startup rather than sent.
# EIA_PAGE_SIZE=5000

# -- Retry policy, by failure class --------------------------------------------
# EIA_TIMEOUT_SECONDS=30
# EIA_MAX_RETRIES=4
# EIA_BACKOFF_BASE_SECONDS=1
# EIA_BACKOFF_MAX_SECONDS=60
# EIA_MAX_RETRY_AFTER_SECONDS=21600
# EIA_MIN_REQUEST_INTERVAL_SECONDS=0.2

# -- Incremental ---------------------------------------------------------------
# Initial operational revision lookback. Deliberately conservative; the real
# revision horizon is not yet measured. See docs/source-data.md section 7.
# EIA_LOOKBACK_MONTHS=24

# -- Raw storage ---------------------------------------------------------------
# Raw objects land at <RAW_ROOT>/<RAW_PREFIX>/... on the local filesystem.
# RAW_ROOT=data/raw
# Logical object-key prefix.
# RAW_PREFIX=raw/eia

# -- Explicit warehouse configuration -----------------------------------------
# No database, role or password is selected by the application for you.
# Supply a DSN for a newly provisioned disposable demo warehouse. Keep credentials
# in your secure local environment; never put a password in a shell argument.
# The package reads process environment variables; it does not source this file.
POSTGRES_DSN=

# -- dbt: every connection field is explicit -----------------------------------
# Fill all target fields before running dbt. An explicitly empty password is only
# appropriate when the selected authentication mechanism does not require one.
DBT_PG_HOST=
DBT_PG_PORT=
DBT_PG_USER=
DBT_PG_DBNAME=
DBT_PG_PASSWORD=

# -- Metabase -----------------------------------------------------------------
# Canonical reporting Compose configuration; see docs/reporting.md.
# Copy this template to the ignored .env.reporting for a NEW reporting project.
# Compose loads it only when explicitly passed --env-file .env.reporting.
# This does not configure or adopt an existing warehouse or Metabase application.
REPORTING_HTTP_PORT=3002
REPORTING_RESTART_POLICY=no
REPORTING_OWNER_PASSWORD_FILE=./.secrets/reporting_owner_password
REPORTING_READER_PASSWORD_FILE=./.secrets/reporting_reader_password
# Create nonempty, private password files separately. No default passwords exist.
# On WSL checkouts under /mnt/c, use absolute paths to private files on the WSL
# Linux filesystem: DrvFS may not enforce the required 0700/0600 permissions.
# The Metabase administrator is initialized privately through its setup UI.
